// ============ BOSS ============
class Boss extends Enemy {
  constructor(game,wave){
    super(game,CFG.W-140,CFG.GROUND_Y-150,400+wave*100,1.0,3000,140,150,'#ff2bd6');
    this.wave=wave; this.phase=1; this.pattern=0; this.patternT=0;
    this.phaseTransition=0;
    audio.boss();
  }
  update(dt){
    this.t+=dt; if(this.flash>0) this.flash-=dt;

    if(this.phase===1 && this.hp<=this.maxHp*0.5){
      this.phase=2; this.phaseTransition=1500;
      this.game.shake(18,700);
      this.game.flash(0.5,'#ff2bd6');
      this.game.shockwaves.push(new Shockwave(this.cx,this.cy,'#ff2bd6',250));
      this.game.particles.burst(this.cx,this.cy,40,'#ff2bd6',7,900,4);
      audio.boss();
      this.speed *= 1.4;
    }
    if(this.phaseTransition>0) this.phaseTransition-=dt;

    this.patternT+=dt;
    const p=this.game.player;
    const targetX = p.cx<CFG.W/2 ? CFG.W-200 : 200;
    const dx=targetX-this.cx;
    this.x += Math.sign(dx)*Math.min(Math.abs(dx),this.speed*DIFF[Settings.difficulty].speedMul);
    this.y = CFG.GROUND_Y-this.h + Math.sin(this.t*0.003)*10;

    if(this.patternT>2000){ this.pattern=(this.pattern+1)%(this.phase===1?3:4); this.patternT=0; }
    this.fireCd-=dt;
    if(this.fireCd<=0){
      if(this.pattern===0){
        this.fireCd=260;
        const count = this.phase===1?5:7;
        for(let i=-(count>>1);i<=count>>1;i++){
          this.game.bullets.push(new Bullet(this.cx,this.cy-20, -4, i*1.5,'enemy',12,'#ff2bd6'));
        }
      } else if(this.pattern===1){
        this.fireCd=this.phase===1?140:90;
        const ddx=p.cx-this.cx, ddy=p.cy-this.cy;
        const m=Math.hypot(ddx,ddy)||1;
        this.game.bullets.push(new Bullet(this.cx,this.cy-20, ddx/m*7, ddy/m*7,'enemy',14,'#ffd400'));
      } else if(this.pattern===2){
        this.fireCd=1400;
        for(let i=0;i<10;i++){
          this.game.bullets.push(new Bullet(this.cx-250+i*55,CFG.GROUND_Y-10, 0,-5,'enemy',10,'#ff7b2b'));
        }
        this.game.shake(10,350);
        audio.explode();
      } else if(this.pattern===3 && this.phase===2){
        this.fireCd=1800;
        for(let i=0;i<3;i++){
          const delay = i*200;
          const self = this;
          setTimeout(()=>{
            if(self.dead || !self.game) return;
            const pp=self.game.player;
            const ddx=pp.cx-self.cx, ddy=pp.cy-self.cy;
            const m=Math.hypot(ddx,ddy)||1;
            self.game.bullets.push(new Bullet(self.cx,self.cy-20, ddx/m*5, ddy/m*5,'enemy',16,'#9d4dff'));
          }, delay);
        }
      }
    }
  }
  draw(ctx){
    ctx.save();
    if(this.phaseTransition>0){
      ctx.globalAlpha = 0.5 + Math.sin(this.t*0.05)*0.5;
    }
    const g=ctx.createLinearGradient(this.x,this.y,this.x,this.y+this.h);
    if(this.phase===1){
      g.addColorStop(0,'#6a0050'); g.addColorStop(1,'#1a0014');
    } else {
      g.addColorStop(0,'#8a0020'); g.addColorStop(1,'#2a0008');
    }
    ctx.fillStyle=g;
    ctx.fillRect(this.x,this.y+30,this.w,this.h-30);
    const headColor = this.flash>0 ? '#ffffff' : (this.phase===1?this.color:'#ff0040');
    ctx.fillStyle=headColor;
    ctx.shadowColor=this.phase===1?this.color:'#ff0040'; ctx.shadowBlur=20;
    ctx.fillRect(this.x+20,this.y, this.w-40, 50);
    ctx.shadowBlur=0;
    ctx.fillStyle='#fff';
    ctx.fillRect(this.x+36,this.y+18,16,10);
    ctx.fillRect(this.x+this.w-52,this.y+18,16,10);
    ctx.fillStyle=this.phase===1?'#ff0040':'#ffd400';
    ctx.fillRect(this.x+40,this.y+22,8,4);
    ctx.fillRect(this.x+this.w-48,this.y+22,8,4);
    ctx.fillStyle='#222';
    ctx.fillRect(this.x-18,this.y+60,24,18);
    ctx.fillRect(this.x+this.w-6,this.y+60,24,18);
    ctx.fillStyle=this.phase===1?this.color:'#ff0040';
    ctx.fillRect(this.x-14,this.y+64,16,10);
    ctx.fillRect(this.x+this.w-2,this.y+64,16,10);
    const coreColor = this.phase===1?'#ffd400':'#ff0040';
    ctx.fillStyle=coreColor;
    ctx.shadowColor=coreColor; ctx.shadowBlur=18;
    ctx.beginPath(); ctx.arc(this.cx,this.y+95,14+Math.sin(this.t*0.01)*3,0,Math.PI*2); ctx.fill();
    ctx.shadowBlur=0;
    ctx.restore();
  }
}

// ============ BACKGROUND ============
class Background {
  constructor(){
    this.stars=[];
    for(let i=0;i<90;i++) this.stars.push({x:Math.random()*CFG.W,y:Math.random()*CFG.H*0.7,s:Math.random()*1.5+0.3,v:Math.random()*0.3+0.05,t:Math.random()*Math.PI*2});
    this.buildings=[];
    for(let i=0;i<14;i++){
      this.buildings.push({
        x:i*90+rand(-20,20), w:rand(60,110), h:rand(120,260),
        c:`hsl(${randi(200,300)},60%,${randi(8,18)}%)`,
        windows:randi(4,12),
        neon: Math.random()<0.3 ? `hsl(${randi(0,360)},100%,60%)` : null
      });
    }
    this.farBuildings=[];
    for(let i=0;i<10;i++){
      this.farBuildings.push({x:i*130,w:rand(80,160),h:rand(80,180)});
    }
    this.scroll=0;
    this.flyingCars=[];
    for(let i=0;i<3;i++) this.flyingCars.push({x:Math.random()*CFG.W,y:rand(60,180),v:rand(1,2.5),c:`hsl(${randi(0,360)},100%,60%)`});
  }
  update(dt){
    this.scroll+=dt*0.02;
    for(const s of this.stars){
      s.x-=s.v; s.t+=dt*0.003;
      if(s.x<0) s.x+=CFG.W;
    }
    for(const c of this.flyingCars){
      c.x -= c.v;
      if(c.x<-30){ c.x=CFG.W+30; c.y=rand(60,180); c.v=rand(1,2.5); }
    }
  }
  draw(ctx){
    const sky=ctx.createLinearGradient(0,0,0,CFG.H);
    sky.addColorStop(0,'#0a0420');
    sky.addColorStop(0.5,'#20083a');
    sky.addColorStop(1,'#05060d');
    ctx.fillStyle=sky; ctx.fillRect(0,0,CFG.W,CFG.H);

    for(const s of this.stars){
      ctx.globalAlpha=0.3+Math.sin(s.t)*0.3+s.s*0.2;
      ctx.fillStyle='#fff';
      ctx.fillRect(s.x,s.y,s.s,s.s);
    }
    ctx.globalAlpha=1;

    ctx.save();
    ctx.fillStyle='#ffd400';
    ctx.shadowColor='#ffd400'; ctx.shadowBlur=30;
    ctx.beginPath(); ctx.arc(CFG.W-120,90,38,0,Math.PI*2); ctx.fill();
    ctx.fillStyle='#0a0420';
    ctx.beginPath(); ctx.arc(CFG.W-108,82,32,0,Math.PI*2); ctx.fill();
    ctx.restore();

    for(const c of this.flyingCars){
      ctx.save();
      ctx.fillStyle=c.c;
      ctx.shadowColor=c.c; ctx.shadowBlur=10;
      ctx.fillRect(c.x,c.y,14,4);
      ctx.fillStyle='#fff';
      ctx.fillRect(c.x+12,c.y+1,2,2);
      ctx.restore();
    }

    const off1=(this.scroll*0.3)%200;
    ctx.fillStyle='#0d0820';
    for(const b of this.farBuildings){
      const x=((b.x-off1)%(CFG.W+200)+CFG.W+200)%(CFG.W+200)-100;
      ctx.fillRect(x,CFG.GROUND_Y-b.h,b.w,b.h);
    }

    const off2=(this.scroll*0.7)%200;
    for(const b of this.buildings){
      const x=((b.x-off2)%(CFG.W+200)+CFG.W+200)%(CFG.W+200)-100;
      ctx.fillStyle=b.c;
      ctx.fillRect(x,CFG.GROUND_Y-b.h,b.w,b.h);
      ctx.fillStyle='rgba(255,212,0,0.55)';
      for(let i=0;i<b.windows;i++){
        const wx=x+6+(i%3)*((b.w-12)/3);
        const wy=CFG.GROUND_Y-b.h+10+Math.floor(i/3)*22;
        if(((i+Math.floor(this.scroll))%7)!==0) ctx.fillRect(wx,wy,6,8);
      }
      if(b.neon){
        ctx.fillStyle=b.neon;
        ctx.shadowColor=b.neon; ctx.shadowBlur=8;
        ctx.fillRect(x+4,CFG.GROUND_Y-b.h+4,b.w-8,3);
        ctx.shadowBlur=0;
      }
    }

    const grd=ctx.createLinearGradient(0,CFG.GROUND_Y,0,CFG.H);
    grd.addColorStop(0,'#1a1030'); grd.addColorStop(1,'#05060d');
    ctx.fillStyle=grd; ctx.fillRect(0,CFG.GROUND_Y,CFG.W,CFG.H-CFG.GROUND_Y);
    ctx.strokeStyle='#ff2bd6'; ctx.lineWidth=2;
    ctx.shadowColor='#ff2bd6'; ctx.shadowBlur=10;
    ctx.beginPath(); ctx.moveTo(0,CFG.GROUND_Y); ctx.lineTo(CFG.W,CFG.GROUND_Y); ctx.stroke();
    ctx.shadowBlur=0;
    ctx.strokeStyle='rgba(0,255,225,0.15)'; ctx.lineWidth=1;
    for(let i=0;i<10;i++){
      const y=CFG.GROUND_Y+4+i*8;
      ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(CFG.W,y); ctx.stroke();
    }
  }
}

// ============ GAME ============
class Game {
  constructor(canvas){
    this.canvas=canvas;
    this.ctx=canvas.getContext('2d');
    this.input=new InputMgr();
    this.particles=new Particles();
    this.bg=new Background();
    this.bullets=[];
    this.enemies=[];
    this.powerups=[];
    this.dmgNumbers=[];
    this.shockwaves=[];
    this.player=new Player(this);
    this.state='menu';
    this.score=0;
    try{ this.hi=parseInt(localStorage.getItem('mw_hi')||'0',10)||0; }catch(e){ this.hi=0; }
    this.wave=1; this.combo=0; this.comboT=0; this.maxCombo=0; this.kills=0;
    this.shakeT=0; this.shakeAmp=0;
    this.flashT=0; this.flashColor='#fff';
    this.muzzleFlash=null;
    this.spawnT=0; this.waveEnemies=0; this.waveTarget=0; this.boss=null;
    this.last=now();
    this._bindUI();
    this._applySettings();
    this._resize();
    window.addEventListener('resize',()=>this._resize());
    this._updateHi();
    requestAnimationFrame(t=>this.loop(t));
  }
  _applySettings(){
    document.getElementById('crt-toggle').checked = Settings.crt;
    document.getElementById('shake-toggle').checked = Settings.shake;
    document.getElementById('music-toggle').checked = Settings.music;
    document.getElementById('sfx-toggle').checked = Settings.sfx;
    document.querySelectorAll('.diff-btn').forEach(b=>{
      b.classList.toggle('active', b.dataset.diff===Settings.difficulty);
    });
    audio.setMusic(Settings.music);
    audio.setSfx(Settings.sfx);
  }
  _resize(){
    const wrap=document.getElementById('game-wrap');
    const ratio=CFG.W/CFG.H;
    const maxW=wrap.clientWidth, maxH=wrap.clientHeight;
    let w=maxW, h=maxW/ratio;
    if(h>maxH){ h=maxH; w=maxH*ratio; }
    this.canvas.style.width=w+'px';
    this.canvas.style.height=h+'px';
    const touch=document.getElementById('touch');
    const isTouch = ('ontouchstart' in window) || navigator.maxTouchPoints>0;
    if(isTouch && (this.state==='playing'||this.state==='shop')) touch.classList.add('on');
    else touch.classList.remove('on');
  }
  _bindUI(){
    const $=id=>document.getElementById(id);
    $('start-btn').onclick=()=>{ audio.init(); audio.resume(); audio.startMusic(); this.startGame(); };
    $('how-btn').onclick=()=>{ $('menu').classList.add('hidden'); $('menu').classList.remove('active'); $('how').classList.remove('hidden'); $('how').classList.add('active'); };
    $('back-btn').onclick=()=>{ $('how').classList.add('hidden'); $('how').classList.remove('active'); $('menu').classList.remove('hidden'); $('menu').classList.add('active'); };
    $('settings-btn').onclick=()=>{ $('menu').classList.add('hidden'); $('menu').classList.remove('active'); $('settings').classList.remove('hidden'); $('settings').classList.add('active'); };
    $('settings-close').onclick=()=>{
      Settings.crt=$('crt-toggle').checked;
      Settings.shake=$('shake-toggle').checked;
      Settings.music=$('music-toggle').checked;
      Settings.sfx=$('sfx-toggle').checked;
      Settings.save();
      this._applySettings();
      $('settings').classList.add('hidden'); $('settings').classList.remove('active'); $('menu').classList.remove('hidden'); $('menu').classList.add('active');
    };
    document.querySelectorAll('.diff-btn').forEach(b=>{
      b.onclick=()=>{
        document.querySelectorAll('.diff-btn').forEach(x=>x.classList.remove('active'));
        b.classList.add('active');
        Settings.difficulty = b.dataset.diff;
        Settings.save();
      };
    });
    $('resume-btn').onclick=()=>this.resume();
    $('quit-btn').onclick=()=>this.toMenu();
    $('retry-btn').onclick=()=>{ this.startGame(); };
    $('menu-btn').onclick=()=>this.toMenu();
    $('pause-btn').onclick=()=>this.pause();
  }
  show(id){ document.getElementById(id).classList.remove('hidden'); document.getElementById(id).classList.add('active'); }
  hide(id){ document.getElementById(id).classList.add('hidden'); document.getElementById(id).classList.remove('active'); }
  startGame(){
    this.hide('menu'); this.hide('over'); this.hide('shop');
    this.show('hud'); document.getElementById('pause-btn').classList.remove('hidden');
    this.score=0; this.wave=1; this.combo=0; this.comboT=0; this.maxCombo=0; this.kills=0;
    this.bullets=[]; this.enemies=[]; this.powerups=[]; this.dmgNumbers=[]; this.shockwaves=[];
    this.particles.list=[];
    this.player.reset();
    this._startWave();
    this.state='playing';
    this._resize();
  }
  _startWave(){
    this.waveTarget = 6 + this.wave*2;
    this.waveEnemies=0;
    this.spawnT=800;
    this.boss=null;
    document.getElementById('boss-wrap').classList.add('hidden');
    document.getElementById('wave').textContent=this.wave;
    this._showBanner(this.wave % CFG.BOSS_EVERY === 0 ? `BOSS WAVE ${this.wave}` : `WAVE ${this.wave}`);
  }
  _showBanner(text){
    const b=document.getElementById('wave-banner');
    b.textContent=text;
    b.classList.remove('show');
    void b.offsetWidth;
    b.classList.add('show');
    setTimeout(()=>b.classList.remove('show'),1800);
  }
  _openShop(){
    this.state='shop';
    const grid=document.getElementById('upgrade-grid');
    grid.innerHTML='';
    const pool = UPGRADES.filter(u=>!u.once || !this.player[u.id+'_owned']);
    const picks=[];
    const copy=[...pool];
    for(let i=0;i<3 && copy.length;i++){
      const idx=randi(0,copy.length);
      picks.push(copy.splice(idx,1)[0]);
    }
    if(picks.length===0){
      // Fallback: just continue
      this._nextWave();
      return;
    }
    picks.forEach(up=>{
      const card=document.createElement('div');
      card.className='upgrade-card';
      card.innerHTML=`<div class="icon">${up.icon}</div><div class="name">${up.name}</div><div class="desc">${up.desc}</div>`;
      card.onclick=()=>{
        up.apply(this.player);
        if(up.once) this.player[up.id+'_owned']=true;
        audio.upgrade();
        this.hide('shop');
        this._nextWave();
      };
      grid.appendChild(card);
    });
    this.show('shop');
    this._resize();
  }
  _nextWave(){
    this.wave++;
    this.bullets=[]; this.enemies=[]; this.powerups=[];
    this.player.x=120; this.player.y=CFG.GROUND_Y-60; this.player.vx=0; this.player.vy=0;
    this._startWave();
    this.state='playing';
  }
  pause(){
    if(this.state!=='playing') return;
    this.state='paused'; this.show('pause');
  }
  resume(){
    if(this.state!=='paused') return;
    this.hide('pause'); this.state='playing'; this.last=now();
  }
  toMenu(){
    this.hide('pause'); this.hide('over'); this.hide('shop'); this.hide('hud');
    document.getElementById('pause-btn').classList.add('hidden');
    document.getElementById('touch').classList.remove('on');
    this.show('menu'); this.state='menu';
  }
  onPlayerDeath(){
    if(this.hi<this.score){
      this.hi=this.score;
      try{ localStorage.setItem('mw_hi',String(this.hi)); }catch(e){}
    }
    this._updateHi();
    document.getElementById('final-score').textContent=this.score;
    document.getElementById('final-wave').textContent=this.wave;
    document.getElementById('final-kills').textContent=this.kills;
    document.getElementById('final-combo').textContent=this.maxCombo;
    document.getElementById('final-hi').textContent=this.hi;
    this.show('over');
    this.state='over';
  }
  addScore(v){
    const mult = 1 + Math.floor(this.combo/5)*0.5;
    const gained = Math.floor(v*mult*DIFF[Settings.difficulty].scoreMul);
    this.score += gained;
    this.combo++; this.comboT=CFG.COMBO_DECAY;
    if(this.combo>this.maxCombo) this.maxCombo=this.combo;
    document.getElementById('score').textContent=this.score;
    const c=document.getElementById('combo');
    if(this.combo>=3) c.textContent=`COMBO x${this.combo} (${mult.toFixed(1)}×)`;
    else c.textContent='';
    if(this.hi<this.score){
      this.hi=this.score;
      try{ localStorage.setItem('mw_hi',String(this.hi)); }catch(e){}
    }
    this._updateHi();
  }
  _updateHi(){ document.getElementById('hi').textContent=this.hi; }
  shake(amp,dur){ if(!Settings.shake) return; this.shakeAmp=Math.max(this.shakeAmp,amp); this.shakeT=Math.max(this.shakeT,dur); }
  flash(intensity,color){ this.flashT=Math.max(this.flashT,intensity*400); this.flashColor=color; }
  spawnEnemy(){
    const r=Math.random();
    const x = CFG.W+20;
    const diff=this.wave;
    const d = DIFF[Settings.difficulty];
    let e;
    if(this.wave>=2 && r<0.2){
      e = new Sniper(this,x);
      e.hp = Math.round(e.hp*diff*d.hpMul); e.maxHp=e.hp;
    } else if(r<0.55){
      e = new Grunt(this,x);
      e.hp = Math.round((e.hp+diff*4)*d.hpMul); e.maxHp=e.hp; e.speed*=d.speedMul;
    } else if(r<0.82){
      e = new Flyer(this,x);
      e.hp = Math.round((e.hp+diff*3)*d.hpMul); e.maxHp=e.hp;
    } else {
      e = new Tank(this,x);
      e.hp = Math.round((e.hp+diff*10)*d.hpMul); e.maxHp=e.hp;
    }
    this.enemies.push(e);
    this.waveEnemies++;
  }
  spawnBoss(){
    this.boss=new Boss(this,this.wave);
    this.boss.hp = Math.round(this.boss.hp*DIFF[Settings.difficulty].hpMul);
    this.boss.maxHp = this.boss.hp;
    this.enemies.push(this.boss);
    document.getElementById('boss-wrap').classList.remove('hidden');
    this.shake(12,600);
    this._showBanner('⚠ BOSS ⚠');
  }
  useBomb(){
    audio.bomb();
    this.shake(18,500);
    this.flash(0.5,'#ffd400');
    this.shockwaves.push(new Shockwave(this.player.cx,this.player.cy,'#ffd400',400));
    for(const b of this.bullets){ if(b.owner==='enemy') b.dead=true; }
    for(const e of this.enemies){
      if(!e.dead){
        e.hit(40);
        this.particles.burst(e.cx,e.cy,15,'#ffd400',5,500,3);
      }
    }
  }
  update(dt){
    if(this.state!=='playing') return;
    if(this.input.pausePressed()){ this.pause(); return; }

    if(this.comboT>0){ this.comboT-=dt; if(this.comboT<=0){ this.combo=0; document.getElementById('combo').textContent=''; } }
    if(this.shakeT>0){ this.shakeT-=dt; this.shakeAmp*=0.92; }
    if(this.flashT>0) this.flashT-=dt;
    if(this.muzzleFlash){ this.muzzleFlash.t-=dt; if(this.muzzleFlash.t<=0) this.muzzleFlash=null; }

    const isBossWave = (this.wave % CFG.BOSS_EVERY === 0);
    if(!this.boss){
      this.spawnT-=dt;
      if(this.spawnT<=0 && this.waveEnemies<this.waveTarget){
        this.spawnEnemy();
        this.spawnT = Math.max(400, 1400 - this.wave*60) / DIFF[Settings.difficulty].spawnMul;
      }
      if(this.waveEnemies>=this.waveTarget && this.enemies.length===0){
        if(isBossWave) this.spawnBoss();
        else this._waveCleared();
      }
    } else {
      if(this.boss.dead){
        this.boss=null;
        this._waveCleared();
      } else {
        document.getElementById('boss-bar').style.width=(this.boss.hp/this.boss.maxHp*100)+'%';
      }
    }

    this.bg.update(dt);
    this.player.update(dt,this.input);
    for(const e of this.enemies) e.update(dt);
    for(const b of this.bullets) b.update(dt);
    for(const p of this.powerups) p.update(dt);
    for(const d of this.dmgNumbers) d.update(dt);
    for(const s of this.shockwaves) s.update(dt);
    this.particles.update(dt);

    this._collisions();

    this.bullets=this.bullets.filter(b=>!b.dead);
    this.enemies=this.enemies.filter(e=>!e.dead);
    this.powerups=this.powerups.filter(p=>!p.dead);
    this.dmgNumbers=this.dmgNumbers.filter(d=>!d.dead);
    this.shockwaves=this.shockwaves.filter(s=>!s.dead);

    document.getElementById('hp-bar').style.width=(this.player.hp/this.player.maxHp*100)+'%';
    document.getElementById('sh-bar').style.width=(this.player.shield/this.player.maxShield*100)+'%';
    const dashMax = CFG.DASH_COOLDOWN*this.player.dashCdMul;
    const dashPct = this.player.dashCd>0 ? (1 - this.player.dashCd/dashMax)*100 : 100;
    document.getElementById('dash-bar').style.width=dashPct+'%';
    document.getElementById('kills').textContent=this.kills;
  }
  _waveCleared(){
    this.player.hp = Math.min(this.player.maxHp, this.player.hp+25);
    this._openShop();
  }
  _collisions(){
    const P=this.player;
    for(const b of this.bullets){
      if(b.owner!=='player'||b.dead) continue;
      for(const e of this.enemies){
        if(e.dead||b.hit.has(e)) continue;
        if(b.x>e.x && b.x<e.x+e.w && b.y>e.y && b.y<e.y+e.h){
          e.hit(b.dmg);
          b.hit.add(e);
          if(b.pierce>0){ b.pierce--; }
          else { b.dead=true; break; }
        }
      }
    }
    if(!P.dead){
      for(const b of this.bullets){
        if(b.owner!=='enemy'||b.dead) continue;
        if(b.x>P.x && b.x<P.x+P.w && b.y>P.y && b.y<P.y+P.h){
          P.takeDamage(b.dmg); b.dead=true;
          this.particles.burst(b.x,b.y,8,'#ff3860',3,300,2);
        }
      }
      for(const e of this.enemies){
        if(e.dead) continue;
        if(P.x<e.x+e.w && P.x+P.w>e.x && P.y<e.y+e.h && P.y+P.h>e.y){
          P.takeDamage(12);
        }
      }
      for(const pu of this.powerups){
        if(pu.dead) continue;
        const dx=pu.x-P.cx, dy=pu.y-P.cy;
        if(dx*dx+dy*dy < (pu.r+22)*(pu.r+22)){
          pu.dead=true; audio.power();
          this.particles.burst(pu.x,pu.y,18,pu.colors[pu.type],4,500,3);
          if(pu.type==='hp'){ P.hp=Math.min(P.maxHp,P.hp+30); }
          else if(pu.type==='shield'){ P.shield=Math.min(P.maxShield,P.shield+30); }
          else if(pu.type==='rapid'){ P.rapid=7000; }
          else if(pu.type==='triple'){ P.triple=7000; }
          else if(pu.type==='bomb'){ this.useBomb(); }
        }
      }
    }
  }
  draw(){
    const ctx=this.ctx;
    ctx.save();
    if(this.shakeT>0 && Settings.shake){
      ctx.translate((Math.random()-0.5)*this.shakeAmp,(Math.random()-0.5)*this.shakeAmp);
    }
    this.bg.draw(ctx);

    for(const p of this.powerups) p.draw(ctx);
    for(const e of this.enemies) e.draw(ctx);
    this.player.draw(ctx);
    for(const b of this.bullets) b.draw(ctx);
    this.particles.draw(ctx);
    for(const s of this.shockwaves) s.draw(ctx);
    for(const d of this.dmgNumbers) d.draw(ctx);

    if(this.muzzleFlash){
      const m=this.muzzleFlash;
      const a=m.t/80;
      ctx.globalAlpha=a;
      ctx.fillStyle='#fff';
      ctx.shadowColor='#ffd400'; ctx.shadowBlur=20;
      ctx.beginPath(); ctx.arc(m.x + m.facing*6, m.y, 8*a, 0, Math.PI*2); ctx.fill();
      ctx.shadowBlur=0; ctx.globalAlpha=1;
    }

    const vg=ctx.createRadialGradient(CFG.W/2,CFG.H/2,CFG.H*0.4,CFG.W/2,CFG.H/2,CFG.H*0.85);
    vg.addColorStop(0,'rgba(0,0,0,0)'); vg.addColorStop(1,'rgba(0,0,0,0.6)');
    ctx.fillStyle=vg; ctx.fillRect(0,0,CFG.W,CFG.H);

    if(this.flashT>0){
      ctx.globalAlpha = clamp(this.flashT/400,0,0.6);
      ctx.fillStyle=this.flashColor;
      ctx.fillRect(0,0,CFG.W,CFG.H);
      ctx.globalAlpha=1;
    }

    if(Settings.crt){
      ctx.globalAlpha=0.08;
      ctx.fillStyle='#000';
      for(let y=0;y<CFG.H;y+=3){
        ctx.fillRect(0,y,CFG.W,1);
      }
      ctx.globalAlpha=1;
    }

    ctx.restore();

    if(this.state==='menu') this.bg.update(16);
  }
  loop(t){
    const dt=Math.min(48,t-this.last);
    this.last=t;
    try{
      this.update(dt);
      this.draw();
    }catch(err){
      console.error('Game loop error:', err);
    }
    this.input.endFrame();
    requestAnimationFrame(tt=>this.loop(tt));
  }
}

// ============ BOOT ============
window.addEventListener('load',()=>{
  try{
    const canvas=document.getElementById('game');
    new Game(canvas);
  }catch(e){
    console.error('Boot error:', e);
    document.body.innerHTML = '<div style="color:#ff3860;padding:20px;font-family:monospace;">Error starting game: '+e.message+'</div>';
  }
});

})();
</script>
